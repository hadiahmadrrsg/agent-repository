rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }
    function myEmail() {
      return request.auth.token.email.lower();
    }
    function meDoc() {
      return get(/databases/$(database)/documents/people/$(myEmail())).data;
    }
    function listed() {
      return signedIn()
        && exists(/databases/$(database)/documents/people/$(myEmail()))
        && meDoc().bpos.size() > 0;
    }
    function isAdmin() {
      return listed() && (meDoc().adm == true || meDoc().sup == true);
    }
    function isSuper() {
      return listed() && meDoc().sup == true;
    }
    function canSee(aud) {
      return aud == 'all' || (aud in meDoc().bpos);
    }

    match /people/{email} {
      allow get: if signedIn() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isSuper();
    }

    match /entries/{id} {
      allow read: if listed()
        && canSee(resource.data.audience)
        && (resource.data.status == 'pub' || isAdmin());
      allow create: if isAdmin()
        && canSee(request.resource.data.audience)
        && request.resource.data.publishedBy == myEmail();
      allow update: if isAdmin()
        && canSee(resource.data.audience)
        && canSee(request.resource.data.audience);
      allow delete: if isAdmin() && canSee(resource.data.audience);
    }

    match /acks/{email} {
      allow get: if listed() && (email == myEmail() || isAdmin());
      allow list: if isAdmin();
      allow create, update: if listed() && email == myEmail();
      allow delete: if isSuper();
    }

    match /requests/{id} {
      allow create: if signedIn()
        && request.resource.data.email == myEmail()
        && request.resource.data.status == 'pending';
      allow read, update, delete: if isSuper();
    }

    match /denied/{id} {
      allow create: if signedIn() && request.resource.data.email == myEmail();
      allow read: if isSuper();
      allow update, delete: if false;
    }

    match /questions/{id} {
      allow create: if listed() && request.resource.data.by == myEmail();
      allow read: if listed();
      allow update, delete: if isAdmin();
    }

    match /events/{id} {
      allow create: if listed() && request.resource.data.who == myEmail();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /nudges/{id} {
      allow create: if isAdmin() && request.resource.data.by == myEmail();
      allow read: if isAdmin();
      allow update, delete: if false;
    }

    match /counters/{key} {
      allow read, write: if isAdmin();
    }

    match /changelog/{v} {
      allow read: if listed();
      allow write: if isSuper();
    }

    match /meta/{doc} {
      allow read: if isAdmin();
      allow write: if isSuper();
    }
  }
}
